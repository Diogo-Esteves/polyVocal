{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PolyVocal",
  "version": "0.2.0",
  "identifier": "com.polyvocal.app",
  "build": {
    "frontendDist": "../src/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../src"
    },
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../src"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PolyVocal",
        "width": 900,
        "height": 700,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
